# ===== 文本生成（DeepSeek，OpenAI 兼容端点）=====
# 目标模型为 deepseek-v4-flash，实际可用模型名以 DeepSeek 官方为准
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 多模态识别（mimo-2.5）=====
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-2.5

# ===== 嵌入（local 表示离线哈希嵌入；openai 表示远端嵌入）=====
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== 数据库 & 向量库 =====
DB_URL=sqlite:///./crop_agent.db
VECTOR_PERSIST_DIR=./storage/chroma
KNOWLEDGE_DIR=../knowledge
TOP_K=5
SIMILARITY_THRESHOLD=0.65

# ===== 索引 =====
CHUNK_SIZE=400
CHUNK_OVERLAP=40
# 置为 true 时启动即重建索引
REINDEX=false

# ===== 混合检索（向量 + BM25 + RRF）=====
# HYBRID_SEARCH=true
# HYBRID_K=60           # RRF 常数 k
# BM25_WEIGHT=0.5       # 展示分中 BM25 权重（与 VECTOR_WEIGHT 之和建议为 1）
# VECTOR_WEIGHT=0.5
# LEXICAL_MIN=0.2       # BM25 归一化分下限（过滤词法噪声）

# ===== 查询改写（检索前用 LLM 扩展短查询）=====
# QUERY_REWRITE=true
# REWRITE_MAX_LEN=30    # 超过此长度不改写

# ===== 重排序（none | llm；cohere/bge 接入点后续扩展）=====
# RERANKER=none
# RERANK_K=20

# ===== 元数据标签（规则标签始终启用；META_TAGGING 预留 LLM 打标签）=====
# META_TAGGING=false
